    orcid: "https://orcid.org/0009-0008-4242-4094"
repository-code: "https://github.com/matthewahester/evidential-audit-workflow"
url: "https://github.com/matthewahester/evidential-audit-workflow"
license: MIT
keywords:
  - meta-analysis
  - Bayesian model averaging
  - RoBMA
  - publication bias
  - evidence synthesis
  - research synthesis methods
  - reproducible workflow
  - evidential audit

preferred-citation:
  type: article
  title: "Quantifying Evidential Rigor in Meta-Analytic Corpora: A Simulation-Characterized, Bias-Robust Bayesian Workflow with a Nutrition Case Study"
